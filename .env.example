# ==============================================================================
# TBC Corporate Communication Website & CMS — Environment Configuration
# Copy this file to `.env` and configure values for your environment.
# NEVER commit `.env` or production secrets to version control.
# ==============================================================================

# Environment: development | staging | production
NODE_ENV=development

# Public canonical URL of the portal (used for canonical URLs, Open Graph, sitemap.xml)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Production / ICT Staging (standard PostgreSQL 15/16+):
# DATABASE_URL=postgresql://tbc_app:CHANGE_ME_STRONG_PASSWORD@localhost:5432/tbc_corporate
# DATABASE_SSL=false
# Staging Compose (set these in a separate private .env.staging; credentials must match):
POSTGRES_DB=tbc_stage
POSTGRES_USER=tbc_stage_app
POSTGRES_PASSWORD=
STAGING_DATABASE_URL=
STAGING_PORT=3000
#
# Local / Private Sandbox Evaluation (embedded PostgreSQL via PGlite):
DATABASE_URL=pglite://./storage/pgdata

# Automatically apply pending migrations and initial seed on first boot if DB is empty
AUTO_INIT_DB=true

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Minimum 32 random bytes (generate with: openssl rand -hex 32)
SESSION_SECRET=REPLACE_WITH_64_CHAR_CRYPTOGRAPHIC_RANDOM_SECRET_BEFORE_PRODUCTION

# Session lifetime in hours (default: 12 hours for corporate CMS)
SESSION_TTL_HOURS=12

# Force Secure flag on session cookies (set to true in HTTPS production; auto-detected via x-forwarded-proto)
COOKIE_SECURE=auto
# Number of trusted reverse-proxy hops. Keep 0 for direct connections; use 1 for the staging compose proxy.
TRUSTED_PROXY_HOPS=0
LOG_LEVEL=info

# Account lockout policy
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Initial Super Administrator bootstrap (used only by `npm run admin:init`)
# Configure these privately before bootstrap. `db:seed` NEVER creates a user.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
# Use at least 16 unique random characters. Never put real credentials in source control.
INITIAL_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# FILE STORAGE & MEDIA LIBRARY
# ------------------------------------------------------------------------------
# Storage provider: local (extensible for s3-compatible Government Data Centre object storage)
STORAGE_PROVIDER=local
UPLOAD_DIR=./storage/uploads
BACKUP_DIR=./storage/backups
# Required for encrypted backups in production; generate a unique 64-character key with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=
# Internal analytics retention (days; default 395)
ANALYTICS_RETENTION_DAYS=395
# Local backup retention (days; newest backup is retained)
BACKUP_RETENTION_DAYS=90
# Maximum upload size in MB (default: 25 MB)
MAX_UPLOAD_SIZE_MB=25
# Optional ClamAV scanner command if installed on host (e.g., clamscan --no-summary)
CLAMAV_COMMAND=

# ------------------------------------------------------------------------------
# EMAIL / SMTP NOTIFICATIONS (OPTIONAL — HONEST STATUS REPORTED WHEN UNSET)
# ------------------------------------------------------------------------------
# Leave SMTP_HOST empty if an authorized SMTP server is not yet configured.
# The CMS will store all submissions safely in PostgreSQL and display a clear warning.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ENQUIRY_NOTIFICATION_EMAIL=

# ------------------------------------------------------------------------------
# GOVERNMENT & EXTERNAL INTEGRATIONS (CONFIGURE ONLY WHEN OFFICIALLY AUTHORIZED)
# ------------------------------------------------------------------------------
# Main TBC News & Broadcasting website
MAIN_TBC_WEBSITE_URL=https://www.tbc.go.tz/

# Optional e-Mrejesho public portal link (do not enable API integration unless authorized by eGA/TBC)
EMREJESHO_PORTAL_URL=https://emrejesho.gov.go.tz/
EMREJESHO_LINK_ENABLED=false

# Optional external web analytics (leave blank to rely exclusively on privacy-safe internal DB analytics)
ANALYTICS_PROVIDER=
ANALYTICS_SITE_ID=
